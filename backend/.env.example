# Copy this file to .env and adjust. Never commit the real .env file.

# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./tickets.db
# PostgreSQL (later): put real credentials only in your local .env, never in code
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/tickets

# Comma-separated list of frontend origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO
